GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=180
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8001","http://localhost:8001"]

# Optional
STORAGE_ROOT=storage
MAX_PDF_FILES=10
MAX_PDF_SIZE_BYTES=20971520
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARACTERS=300000
MAX_VISUAL_ASSET_FILES=20
MAX_VISUAL_ASSET_SIZE_BYTES=20971520
